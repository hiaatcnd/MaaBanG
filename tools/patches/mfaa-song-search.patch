+/// <summary>
+/// 选项下拉专用的 ComboBox：下拉打开且搜索框拥有焦点时，跳过基类对空格键的
+/// “选中当前项并关闭下拉”处理，让空格作为普通文本输入进入搜索框。
+/// 注意不能把 KeyDown 标记为已处理：Avalonia 的 Win32 后端会因此丢弃 WM_CHAR，
+/// TextBox 将收不到任何文字（空格永远无法输入）。
+/// </summary>
+public sealed class SearchComboBox : ComboBox
+{
+    // 让 SearchComboBox 直接复用 SukiUI 为 ComboBox 定义的样式与模板（搜索框所在模板）。
+    protected override Type StyleKeyOverride => typeof(ComboBox);
+
+    protected override void OnKeyDown(KeyEventArgs e)
+    {
+        if (IsDropDownOpen
+            && e.Key == Key.Space
+            && ComboBoxExtensions.GetCanSearch(this)
+            && IsSearchBoxFocused())
+        {
+            return;
+        }
+
+        base.OnKeyDown(e);
+    }
+
+    private bool IsSearchBoxFocused()
+    {
+        var popup = this.FindDescendantOfType<Popup>();
+        if (popup?.Child is not Visual visual)
+            return false;
+
+        return visual.GetVisualDescendants()
+            .OfType<TextBox>()
+            .Any(textBox => textBox.Name == "PART_SearchBox" && textBox.IsFocused);
+    }
+}

