{
    "interface_version": 2,
    "name": "MaaBanG",
    "description": "基于 MaaFramework 的 BanG Dream 手游中国服自动化助手。",
    "contact": "问题反馈：https://github.com/hiaatcnd/MaaBanG/issues",
    "license": "MIT",
    "welcome": "欢迎使用 MaaBanG！请先启动模拟器并开启 ADB 调试，再选择安卓端连接设备。当前处于开发阶段，游戏任务将逐步添加。",
    "github": "https://github.com/hiaatcnd/MaaBanG",
    "version": "v0.2.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "中国服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "解锁默认3D演出服装",
            "entry": "UnlockCostumes",
            "description": "支持全部成员、指定乐队或指定成员，根据评级进度将默认3D演出服装补到目标数量；收集任务全部完成的角色直接跳过。裁缝套装或金币不足时停止。请从主页、乐队或角色评级页面启动。 每位成员解锁结束后领取服装收集奖励，任务完成后返回主页；不会更换穿搭。",
            "option": [
                "服装执行范围",
                "服装目标数量",
                "服装执行模式"
            ]
        },
        {
            "name": "领取主页礼物",
            "entry": "ClaimHomeGifts",
            "description": "领取礼物箱中所有可领取礼物，完成后返回主页。",
            "default_check": false
        },
        {
            "name": "领取任务奖励",
            "entry": "ClaimHomeMissions",
            "description": "依次领取各类任务中已达成的奖励，不自动完成演出条件；结束后返回主页。",
            "default_check": false
        },
        {
            "name": "米歇尔贴纸交换",
            "entry": "ExchangeMichelle",
            "description": "使用米歇尔贴纸，交换成员、表情、服装、背景、其他分类中所有未拥有且未达到交换上限的项目。余额不足时停止，完成后返回主页。",
            "default_check": false
        },
        {
            "name": "每日免费招募",
            "entry": "DailyFreeRecruit",
            "description": "仅执行每日3次免费演出招募的剩余可用次数，不使用星石或招募券，完成后返回主页。",
            "default_check": false
        }
    ],
    "option": {
        "服装目标数量": {
            "type": "input",
            "inputs": [
                {
                    "name": "目标数量",
                    "label": "每位角色的目标数量",
                    "default": "0",
                    "verify": "^(0|[1-9][0-9]{0,2})$",
                    "pattern_msg": "请输入0–999的整数，0表示不解锁",
                    "pipeline_type": "int"
                }
            ],
            "pipeline_override": {
                "UnlockCostumes": {
                    "custom_action_param": {
                        "target": "{目标数量}"
                    }
                }
            }
        },
        "服装执行模式": {
            "type": "select",
            "cases": [
                {
                    "name": "解锁服装",
                    "pipeline_override": {
                        "CU_ExecutionOptions": {
                            "attach": {
                                "inspect_only": false
                            }
                        }
                    }
                },
                {
                    "name": "仅检查（不消耗道具）",
                    "pipeline_override": {
                        "CU_ExecutionOptions": {
                            "attach": {
                                "inspect_only": true
                            }
                        }
                    }
                }
            ]
        },
        "服装执行范围": {
            "type": "select",
            "cases": [
                {
                    "name": "全部成员",
                    "pipeline_override": {
                        "CU_ScopeMode": {
                            "attach": {
                                "kind": "all"
                            }
                        }
                    }
                },
                {
                    "name": "指定乐队",
                    "option": [
                        "服装指定乐队"
                    ],
                    "pipeline_override": {
                        "CU_ScopeMode": {
                            "attach": {
                                "kind": "band"
                            }
                        }
                    }
                },
                {
                    "name": "指定成员",
                    "option": [
                        "服装指定成员"
                    ],
                    "pipeline_override": {
                        "CU_ScopeMode": {
                            "attach": {
                                "kind": "member"
                            }
                        }
                    }
                }
            ]
        },
